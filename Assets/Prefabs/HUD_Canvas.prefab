  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SettingsAAARuntime
  settingsUI: {fileID: 305856459928155197}
  canvasGroup: {fileID: 7128934134691257133}
  descriptionText: {fileID: 2055956098541858633}
  categoryRoots:
  - {fileID: 2914959419986574262}
  - {fileID: 3717845905412022204}
  - {fileID: 1895116991958950316}
  - {fileID: 9170369503875970991}
  - {fileID: 320922968029751906}
  - {fileID: 3595656969606490606}
  - {fileID: 2350963247345212067}
  - {fileID: 6369041904683635509}
  categoryStripes:
  - {fileID: 6426040179638191276}
  - {fileID: 526995764170238412}
  - {fileID: 5742375181830062905}
  - {fileID: 8765781594940811803}
  - {fileID: 2824782632130812371}
  - {fileID: 6420171911771082808}
  - {fileID: 58990385773321558}
  - {fileID: 4104192493795146111}
  accentColor: {r: 1, g: 0.82, b: 0.24, a: 1}
  dimAccent: {r: 1, g: 0.82, b: 0.24, a: 0.12}
  hoverRows:
  - row: {fileID: 7090563876826970056}
    description: Toggle the on-screen frames-per-second counter.
  - row: {fileID: 9077808704642992013}
    description: Quick on/off cap. Use the FPS Cap dropdown in Video for exact values.
  - row: {fileID: 8550013749442838607}
    description: Periodically save progress without prompting.
  - row: {fileID: 5829490580319645681}
    description: Combat scaling. Easy / Normal / Hard / Hardcore. Hardcore disables
      checkpoints.
  - row: {fileID: 507122347358148871}
    description: Show floating damage numbers above enemies you hit.
  - row: {fileID: 6772753068875398692}
    description: Camera shake on impacts and explosions. Disable if it causes discomfort.
  - row: {fileID: 2463451574222836771}
    description: Brief freeze on heavy hits for impact. Disable for smoother combat.
  - row: {fileID: 2990144236363004319}
    description: Red edge tint when health is critical. Disable to reduce visual
      noise.
  - row: {fileID: 5079341291616357213}
    description: Show contextual hint popups when new mechanics appear.
  - row: {fileID: 4285307532107499041}
    description: "Overall game volume \u2014 affects every channel."
  - row: {fileID: 1857663134765367545}
    description: Background music and ambient score.
  - row: {fileID: 6746332607159423407}
    description: Combat and world impact sounds.
  - row: {fileID: 9115122171273460773}
    description: Dialogue and narration.
  - row: {fileID: 8051759989473735008}
    description: Menu, button, and HUD sounds.
  - row: {fileID: 4476134881074347399}
    description: "World ambience \u2014 wind, fire, water."
  - row: {fileID: 3494975515997696601}
    description: Silence the game when the window loses focus (Alt-Tab).
  - row: {fileID: 8686232477260803184}
    description: Render and output resolution. Lower for performance, higher for
      sharpness.
  - row: {fileID: 6560435937885708161}
    description: Fullscreen (exclusive), Borderless (snappy alt-tab), or Windowed.
  - row: {fileID: 2456771402147157085}
    description: "Monitor refresh rate target \u2014 only meaningful in Fullscreen."
  - row: {fileID: 506904964372648326}
    description: Which display the game uses on multi-monitor setups.
  - row: {fileID: 7906838620667058355}
    description: Hard frame-rate cap. Unlimited = no cap. Lower caps reduce heat
      / battery.
  - row: {fileID: 6492273484026049026}
    description: Synchronise rendering to monitor refresh. Eliminates tearing but
      adds input lag.
  - row: {fileID: 2564016966284781922}
    description: Wider FOV shows more peripheral vision but distorts edges. Default
      75.
  - row: {fileID: 7549612847475853572}
    description: Scene brightness multiplier. 1 = default.
  - row: {fileID: 5187984028229113889}
    description: Mid-tone luminance. Lift shadows or crush highlights.
  - row: {fileID: 8416224557196861472}
    description: Master quality preset. Overrides individual tiers below.
  - row: {fileID: 3320803585514003041}
    description: Internal resolution as % of output. Lower for more FPS, higher for
      super-sampling.
  - row: {fileID: 3209312541242505527}
    description: Smooths jagged edges. FXAA cheap, SMAA balanced, TAA highest quality.
  - row: {fileID: 3564760051203740700}
    description: Texture mip level. Low saves VRAM, Ultra gives sharpest surfaces.
  - row: {fileID: 6971312406619995606}
    description: Off / Hard / Soft Low / Soft High. Biggest single-toggle performance
      lever.
  - row: {fileID: 8726952513699975473}
    description: How far from the camera shadows are rendered, in metres.
  - row: {fileID: 3447841531510262957}
    description: Master post-processing toggle (bloom + grading + DOF).
  - row: {fileID: 8575667462844065443}
    description: Realtime shadows on minor lights (torches, candles).
  - row: {fileID: 3370713960293579532}
    description: Per-object motion blur on fast movement. Off for clarity.
  - row: {fileID: 4425702755849550771}
    description: Cinematic focus blur during cutscenes and aim.
  - row: {fileID: 7778425963496268917}
    description: Soft glow around bright pixels.
  - row: {fileID: 6577245266566654052}
    description: "Soft shading in crevices and corners \u2014 adds depth, costs frames."
  - row: {fileID: 240023639765886844}
    description: God rays through fog. Expensive on lower-end GPUs.
  - row: {fileID: 3920184446641280375}
    description: Camera sensitivity multiplier. 1 = default. Raise for snappy aim.
  - row: {fileID: 4577735365264114246}
    description: Flip vertical look direction. Down on the mouse looks up.
  - row: {fileID: 8730866728421013502}
    description: Rumble on impacts when using a gamepad.
  - row: {fileID: 3875627572205460741}
    description: Sticky-aim strength on gamepad. 0 = off, 1 = strong magnet.
  - row: {fileID: 2303042342917415865}
    description: Show on-screen text for dialogue and narration.
  - row: {fileID: 973648751662754239}
    description: How large subtitle text is rendered.
  - row: {fileID: 8182942364703832505}
    description: Render subtitles on a translucent dark plate for readability.
  - row: {fileID: 9099025787411653740}
    description: Recolor highlights for color-vision deficiencies.
  - row: {fileID: 6257604958135993122}
    description: Boost contrast on HUD elements for visibility.
  - row: {fileID: 5461806602076368551}
    description: Disable camera bob, screen sway, and aggressive transitions.
  - row: {fileID: 1127071373147161494}
    description: Replace strobing flashes with steady glows.
  - row: {fileID: 7775769503844966992}
    description: Scale the HUD up to 150% for readability.
  - row: {fileID: 578640800488001869}
    description: Game text language. Voice remains in its original language unless
      changed below.
  - row: {fileID: 8144003773981015123}
    description: Spoken dialogue language for cutscenes and barks.
